PAYLOAD_SECRET=mygeneratedsecret
DATABASE_URL=mongodb://127.0.0.1/template-ecommerce

COMPANY_NAME="Payload Inc."
TWITTER_CREATOR="@payloadcms"
TWITTER_SITE="https://nextjs.org/commerce"
SITE_NAME="Payload Commerce"

PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Used to preview drafts
PREVIEW_SECRET=demo-draft-secret

# LiqPay API keys
LIQPAY_PUBLIC_KEY=sandbox_
LIQPAY_PRIVATE_KEY=sandbox_
LIQPAY_API_VERSION=7
# Current LiqPay v7 documentation specifies sha3-256. Set sha1 only if sandbox verification
# proves that the merchant account still uses the legacy signing protocol.
LIQPAY_HASH_ALGORITHM=sha3-256
LIQPAY_ALLOWED_PAYTYPES=apay,gpay,card,privat24,moment_part,paypart,qr

# Nova Poshta API (server-side only)
NOVA_POSHTA_API_KEY=
NOVA_POSHTA_API_URL=https://api.novaposhta.ua/v2.0/json/
NOVA_POSHTA_SENDER_REF=
NOVA_POSHTA_SENDER_CONTACT_REF=
NOVA_POSHTA_SENDER_CITY_REF=
NOVA_POSHTA_SENDER_WAREHOUSE_REF=
NOVA_POSHTA_SENDER_PHONE=
NOVA_POSHTA_DEFAULT_WEIGHT_KG=1
NOVA_POSHTA_SHIPMENT_DESCRIPTION=Books
# Enable only after the sender refs above have been verified in a Nova Poshta business account.
NOVA_POSHTA_CREATE_WAYBILL_ON_ORDER=false
